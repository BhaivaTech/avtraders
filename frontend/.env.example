# ---- API & Socket ----
# Leave empty in production (Apache proxies /api and /socket.io to the backend)
# Set to backend URL for local development e.g. http://localhost:5100
VITE_API_BASE_URL=http://localhost:5100

# ---- App Display ----
VITE_SITE_TITLE=AV Traders Agri Clinic
VITE_SITE_URL=https://www.yourdomain.com

# ---- Business Contact ----
VITE_CONTACT_EMAIL=info@yourdomain.com
VITE_CONTACT_PHONE=+910000000000
VITE_WHATSAPP_URL=https://wa.me/910000000000
VITE_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/your_channel_id

# ---- Google Maps ----
VITE_MAPS_LINK=https://maps.app.goo.gl/your_link
VITE_MAPS_ADDRESS=Your Full Business Address, City, State, PIN

# ---- UPI (URL-encoded for payment links) ----
VITE_UPI_ID=yourupi@bank
VITE_UPI_NAME=Your%20Business%20Name

# ---- Admin login guard (frontend-side; server enforces real auth) ----
VITE_ADMIN_EMAIL=admin@yourdomain.com
