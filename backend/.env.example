# ---- Server ----
NODE_ENV=development                  # development | production
HOST=127.0.0.1
PORT=5100
SESSION_SECRET=your_strong_random_session_secret_here

# ---- CORS ----
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5100

# ---- Cookie (cross-domain, prod only) ----
COOKIE_DOMAIN=.yourdomain.com

# ---- MySQL Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# ---- Uploads ----
UPLOAD_DIR=./uploads

# ---- CSRF Protection ----
# Set to 1 to disable CSRF checks (ONLY for testing / API-only clients)
CSRF_DISABLED=0

# ---- Logging ----
LOG_LEVEL=debug                       # trace | debug | info | warn | error | fatal

# ---- Sentry Error Tracking (optional) ----
# Get your DSN from https://sentry.io
SENTRY_DSN=

# ---- Backup Configuration ----
BACKUP_DIR=./backups
BACKUP_RETAIN=7                       # Number of backups to keep
BACKUP_COMPRESS=true                  # Enable gzip compression

# ---- Farmer OTP / WhatsApp (MSG91) ----
OTP_PROVIDER=msg91_whatsapp          # msg91_whatsapp | smtp
OTP_EXPIRY_SECONDS=300
OTP_DEV_FALLBACK=0                   # Set to 1 in dev to skip real OTP sending
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_WA_TEMPLATE_NAME=otp_login_1
MSG91_WA_NAMESPACE=your_msg91_namespace_uuid
MSG91_WA_INTEGRATED_NUMBER=91XXXXXXXXXX
MSG91_WA_LANG_CODE=en
MSG91_WA_BUTTON_PREFIX=

# ---- Admin Login (SMTP OTP) ----
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_admin_password
ADMIN_OTP_PROVIDER=smtp
ADMIN_OTP_EXPIRY_SECONDS=60
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_email@gmail.com
SMTP_PASS=your_smtp_app_password      # Use a Gmail App Password, not your account password

# ---- PhonePe Payment Gateway ----
PHONEPE_ENV=sandbox                   # sandbox | prod
PHONEPE_MERCHANT_ID=your_merchant_id
PHONEPE_SALT_KEY=your_salt_key
PHONEPE_SALT_INDEX=1

# ---- PhonePe SDK (Standard Checkout v2) ----
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1

# ---- JWT (Dealer Portal) ----
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ---- Public URLs ----
PUBLIC_BASE_URL=http://localhost:5100
BACKEND_BASE_URL=http://localhost:5100
APP_ORIGIN=http://localhost:5173
